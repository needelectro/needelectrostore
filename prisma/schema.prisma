  voucherNumber  String   @unique @map("voucher_number")
  category       String
  amount         Decimal  @db.Decimal(12, 2)
  date           DateTime @default(now())
  paymentMethod  String   @map("payment_method")
  branchId       String   @map("branch_id")
  description    String
  attachmentName String?  @map("attachment_name")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([voucherNumber])
  @@index([category])
  @@index([branchId])
  @@index([date])
  @@map("expenses")
}

// ---------------------------------------------------------
// 15. TECHNICAL & ELECTRICAL SERVICES
// ---------------------------------------------------------

model ServiceCategoryConfig {
  id                     String  @id
  name                   String
  code                   String  @unique
  defaultLaborCost       Decimal @default(0) @map("default_labor_cost") @db.Decimal(12, 2)
  estimatedDurationHours Decimal @default(2.0) @map("estimated_duration_hours") @db.Decimal(4, 1)
  warrantyDays           Int     @default(30) @map("warranty_days")
  description            String?
  isActive               Boolean @default(true) @map("is_active")

  @@map("service_categories_config")
}

model ServiceJob {
  id                    String    @id
  jobCardNumber         String    @unique @map("job_card_number")
  customerId            String    @map("customer_id")
  customerName          String    @map("customer_name")
  customerPhone         String    @map("customer_phone")
  customerAddress       String?   @map("customer_address")
  serviceType           String    @map("service_type")
  deviceOrSite          String    @map("device_or_site")
  serialNumber          String?   @map("serial_number")
  reportedIssue         String    @map("reported_issue")
  assignedTechnicianId  String?   @map("assigned_technician_id")
  assignedTechnicianName String?  @map("assigned_technician_name")
  status                String    @default("Pending")
  partsUsed             Json?     @map("parts_used")
  laborCost             Decimal   @default(0) @map("labor_cost") @db.Decimal(12, 2)
  totalBill             Decimal   @default(0) @map("total_bill") @db.Decimal(12, 2)
  paymentStatus         String    @default("UNPAID") @map("payment_status")
  paymentMethod         String?   @map("payment_method")
  scheduledDate         DateTime? @map("scheduled_date")
  completedDate         DateTime? @map("completed_date")
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([jobCardNumber])
  @@index([customerId])
  @@index([status])
  @@map("service_jobs")
}

model Technician {
  id                 String  @id
  name               String
  phone              String
  email              String?
  specialization     Json?   // String array
  activeJobsCount    Int     @default(0) @map("active_jobs_count")
  completedJobsCount Int     @default(0) @map("completed_jobs_count")
  totalEarnings      Decimal @default(0) @map("total_earnings") @db.Decimal(12, 2)
  rating             Decimal @default(5.0) @db.Decimal(3, 2)

  @@map("technicians")
}

// ---------------------------------------------------------
// 16. WARRANTY MANAGEMENT
// ---------------------------------------------------------

model WarrantyRuleConfig {
  id                 String  @id
  categoryName       String  @map("category_name")
  defaultMonths      Int     @default(12) @map("default_months")
  termsText          String  @map("terms_text")
  replacementAllowed Boolean @default(false) @map("replacement_allowed")
  repairAllowed      Boolean @default(true) @map("repair_allowed")
  voidConditions     String? @map("void_conditions")
  isActive           Boolean @default(true) @map("is_active")

  @@map("warranty_rules_config")
}

model WarrantyClaim {
  id               String    @id
  claimNumber      String    @unique @map("claim_number")
  serialNumber     String    @map("serial_number")
  productName      String    @map("product_name")
  customerId       String    @map("customer_id")
  customerName     String    @map("customer_name")
  customerPhone    String    @map("customer_phone")
  invoiceNumber    String    @map("invoice_number")
  issueDescription String    @map("issue_description")
  claimDate        DateTime  @default(now()) @map("claim_date")
  status           String    @default("PENDING")
  resolutionNotes  String?   @map("resolution_notes")
  resolvedDate     DateTime? @map("resolved_date")

  @@index([claimNumber])
  @@index([serialNumber])
  @@index([status])
  @@map("warranty_claims")
}

// ---------------------------------------------------------
// 17. INVESTMENTS & FUND TRANSFERS
// ---------------------------------------------------------

model Investment {
  id               String   @id
  referenceNumber  String   @unique @map("reference_number")
  investorName     String   @map("investor_name")
  amount           Decimal  @db.Decimal(12, 2)
  date             DateTime @default(now())
  investmentType   String   @map("investment_type")
  depositAccountId String   @map("deposit_account_id")
  paymentMethod    String   @map("payment_method")
  reference        String?
  status           String   @default("ACTIVE")
  notes            String?
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  investorId       String?  @map("investor_id")
  investor         Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  @@index([referenceNumber])
  @@index([investorId])
  @@map("investments")
}

model FundTransfer {
  id             String   @id
  transferNumber String   @unique @map("transfer_number")
  date           DateTime @default(now())
  fromAccountId  String   @map("from_account_id")
  toAccountId    String   @map("to_account_id")
  amount         Decimal  @db.Decimal(12, 2)
  fee            Decimal  @default(0) @db.Decimal(12, 2)
  reference      String?
  transferredBy  String   @map("transferred_by")
  notes          String?

  @@index([transferNumber])
  @@map("fund_transfers")
}

// ---------------------------------------------------------
// 18. HUMAN RESOURCES & ATTENDANCE
// ---------------------------------------------------------

model Employee {
  id                   String   @id
  name                 String
  email                String
  phone                String
  role                 String
  designation          String?
  branchId             String   @map("branch_id")
  monthlySalary        Decimal  @default(0) @map("monthly_salary") @db.Decimal(12, 2)
  salesCommissionRate  Decimal  @default(0) @map("sales_commission_rate") @db.Decimal(5, 2)
  joinedDate           DateTime @default(now()) @map("joined_date")
  nid                  String?
  address              String?
  emergencyContact     String?  @map("emergency_contact")
  status               String   @default("ACTIVE")

  @@index([email])
  @@index([phone])
  @@map("employees")
}

model Attendance {
  id           String   @id
  employeeId   String   @map("employee_id")
  employeeName String   @map("employee_name")
  date         DateTime @default(now())
  status       String   // PRESENT, ABSENT, LATE, LEAVE
  checkInTime  String?  @map("check_in_time")
  checkOutTime String?  @map("check_out_time")
  notes        String?

  @@index([employeeId])
  @@index([date])
  @@map("attendance")
}

// ---------------------------------------------------------
// 19. LEDGER-BASED INVENTORY & DOUBLE-ENTRY LEDGERS
// ---------------------------------------------------------

model InventoryTransaction {
  id                String   @id
  transactionNumber String   @unique @map("transaction_number")
  date              DateTime @default(now())
  type              String   // PURCHASE_IN, SALE_OUT, RETURN_IN, DAMAGE_OUT, ADJUSTMENT, TRANSFER
  productId         String   @map("product_id")
  productName       String   @map("product_name")
  branchId          String   @map("branch_id")
  fromBranchId      String?  @map("from_branch_id")
  toBranchId        String?  @map("to_branch_id")
  quantity          Int
  unitCost          Decimal  @map("unit_cost") @db.Decimal(12, 2)
  totalValue        Decimal  @map("total_value") @db.Decimal(12, 2)
  openingStock      Int      @map("opening_stock")
  closingStock      Int      @map("closing_stock")
  referenceType     String?  @map("reference_type")
  referenceId       String?  @map("reference_id")
  serialNumbers     Json?    @map("serial_numbers")
  notes             String?
  createdBy         String   @map("created_by")

  @@index([transactionNumber])
  @@index([productId])
  @@index([branchId])
  @@index([date])
  @@map("inventory_transactions")
}

model LedgerEntry {
  id                   String    @id
  date                 DateTime  @default(now())
  partyType            String    @map("party_type") // CUSTOMER, SUPPLIER, ACCOUNT, SYSTEM
  partyId              String    @map("party_id")
  referenceType        String    @map("reference_type") // SALE, SALE_RETURN, PURCHASE, PURCHASE_RETURN, DUE_PAYMENT, SUPPLIER_PAYMENT, EXPENSE, EXPENSE_REVERSAL, INVESTMENT, OWNER_WITHDRAWAL, TRANSFER, OTHER_INCOME, OTHER_EXPENSE, CASH_ADJUSTMENT, OPENING_BALANCE
  referenceNumber      String    @map("reference_number")
  description          String
  debit                Decimal   @default(0) @db.Decimal(12, 2)
  credit               Decimal   @default(0) @db.Decimal(12, 2)
  runningBalance       Decimal   @default(0) @map("running_balance") @db.Decimal(12, 2)
  status               String    @default("COMPLETED") // COMPLETED, CANCELLED, REVERSED, RETURNED
  reversalOfId         String?   @map("reversal_of_id")
  relatedTransactionId String?   @map("related_transaction_id")
  paymentMethod        String?   @map("payment_method")
  performedBy          String?   @map("performed_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime? @updatedAt @map("updated_at")

  @@index([partyType, partyId])
  @@index([date])
  @@index([referenceNumber])
  @@index([status])
  @@index([referenceType])
  @@map("ledger_entries")
}

model OtherIncome {
  id             String    @id
  incomeNumber   String    @unique @map("income_number")
  category       String
  amount         Decimal   @db.Decimal(12, 2)
  date           DateTime  @default(now())
  accountId      String    @map("account_id")
  paymentMethod  String    @default("Cash") @map("payment_method")
  reference      String?
  description    String
  receivedFrom   String?   @map("received_from")
  branchId       String?   @map("branch_id")
  status         String    @default("COMPLETED") // COMPLETED, REVERSED, CANCELLED
  receivedBy     String    @map("received_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime? @updatedAt @map("updated_at")

  @@index([incomeNumber])
  @@index([date])
  @@index([category])
  @@map("other_incomes")
}

model OwnerWithdrawal {
  id               String    @id
  withdrawalNumber String    @unique @map("withdrawal_number")
  ownerName        String    @map("owner_name")
  amount           Decimal   @db.Decimal(12, 2)
  date             DateTime  @default(now())
  sourceAccountId  String    @map("source_account_id")
  paymentMethod    String    @default("Cash") @map("payment_method")
  reference        String?
  purpose          String?
  status           String    @default("COMPLETED") // COMPLETED, REVERSED, CANCELLED
  approvedBy       String    @map("approved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  @@index([withdrawalNumber])
  @@index([date])
  @@map("owner_withdrawals")
}

// ---------------------------------------------------------
// 20. AUDIT LOGS & COMPLIANCE
// ---------------------------------------------------------

model AuditLog {
  id        String   @id
  timestamp DateTime @default(now())
  userId    String   @map("user_id")
  userName  String   @map("user_name")
  action    String
  module    String
  recordId  String   @map("record_id")
  details   String
  ipAddress String?  @map("ip_address")

  @@index([timestamp])
  @@index([userId])
  @@index([module])
  @@map("audit_logs")
}

model PriceAudit {
  id          String   @id
  productId   String   @map("product_id")
  productName String   @map("product_name")
  sku         String
  priceType   String   @map("price_type")
  oldPrice    Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice    Decimal  @map("new_price") @db.Decimal(12, 2)
  changedBy   String   @map("changed_by")
  reason      String
  timestamp   DateTime @default(now())

  @@index([productId])
  @@index([timestamp])
  @@map("price_audits")
}

model CustomerMergeAudit {
  id                     String   @id
  sourceCustomerId       String   @map("source_customer_id")
  sourceCustomerName     String   @map("source_customer_name")
  targetCustomerId       String   @map("target_customer_id")
  targetCustomerName     String   @map("target_customer_name")
  movedInvoicesCount     Int      @map("moved_invoices_count")
  movedEmiAccountsCount  Int      @map("moved_emi_accounts_count")
  movedServiceJobsCount  Int      @map("moved_service_jobs_count")
  performedBy            String   @map("performed_by")
  timestamp              DateTime @default(now())
  reason                 String

  @@map("customer_merge_audits")
}

model OpeningBalance {
  id         String   @id
  date       DateTime @default(now())
  type       String   // CASH, BANK, CUSTOMER, SUPPLIER
  targetId   String   @map("target_id")
  targetName String   @map("target_name")
  amount     Decimal  @db.Decimal(12, 2)
  notes      String?
  approvedBy String   @map("approved_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("opening_balances")
}

model NotificationTemplateConfig {
  id         String  @id
  code       String  @unique
  title      String
  templateEn String  @map("template_en")
  templateBn String  @map("template_bn")
  channels   Json?   // String array
  isActive   Boolean @default(true) @map("is_active")

  @@map("notification_templates_config")
}

model DatabaseBackup {
  id          String   @id
  filename    String
  sizeBytes   BigInt   @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")
  description String?

  @@map("database_backups")
}

// ---------------------------------------------------------
// 21. CASH MANAGEMENT & ADJUSTMENTS
// ---------------------------------------------------------

model CashAdjustment {
  id               String   @id
  adjustmentNumber String   @unique @map("adjustment_number")
  date             DateTime @default(now())
  type             String   // INFLOW, OUTFLOW
  reason           String   // OPENING_BALANCE_CORRECTION, CASH_SHORTAGE, CASH_EXCESS, MANUAL_DEPOSIT, MANUAL_WITHDRAWAL, OTHER
  amount           Decimal  @db.Decimal(12, 2)
  accountId        String   @map("account_id")
  paymentMethod    String   @default("Cash") @map("payment_method")
  reference        String?
  notes            String?
  branchId         String?  @map("branch_id")
  performedBy      String   @map("performed_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([adjustmentNumber])
  @@index([date])
  @@map("cash_adjustments")
}

model CustomerPayment {
  id            String   @id
  receiptNumber String   @unique @map("receipt_number")
  customerId    String   @map("customer_id")
  customerName  String   @map("customer_name")
  amount        Decimal  @db.Decimal(12, 2)
  paymentDate   DateTime @default(now()) @map("payment_date")
  paymentMethod String   @map("payment_method")
  accountId     String?  @map("account_id")
  reference     String?
  notes         String?
  collectedBy   String   @map("collected_by")
  createdAt     DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([receiptNumber])
  @@index([customerId])
  @@index([paymentDate])
  @@map("customer_payments")
}

// ---------------------------------------------------------
// 22. INVESTORS & PROFIT SETTLEMENT
// ---------------------------------------------------------

model Investor {
  id              String   @id
  investorId      String   @unique @map("investor_id") // e.g. "INV-001"
  name            String
  email           String   @unique
  phone           String?
  userId          String   @unique @map("user_id")
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investments     Investment[]
  monthlyProfits  InvestorMonthlyProfit[]

  @@map("investors")
}

model MonthlySettlement {
  id                     String    @id // e.g. "settlement-2026-09"
  year                   Int
  month                  Int       // 1 - 12
  periodLabel            String    @map("period_label") // e.g. "September 2026"
  revenue                Decimal   @db.Decimal(12, 2)
  cogs                   Decimal   @default(0) @db.Decimal(12, 2)
  expenses               Decimal   @db.Decimal(12, 2)
  netProfit              Decimal   @map("net_profit") @db.Decimal(12, 2)
  investorPoolRate       Decimal   @default(25.0) @map("investor_pool_rate") @db.Decimal(5, 2)
  investorProfitPool     Decimal   @map("investor_profit_pool") @db.Decimal(12, 2)
  totalActiveInvestment  Decimal   @map("total_active_investment") @db.Decimal(12, 2)
  status                 String    @default("FINALIZED") // DRAFT, FINALIZED
  finalizedAt            DateTime? @map("finalized_at")
  finalizedBy            String?   @map("finalized_by")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  investorProfits        InvestorMonthlyProfit[]

  @@unique([year, month])
  @@map("monthly_settlements")
}

model InvestorMonthlyProfit {
  id               String   @id
  settlementId     String   @map("settlement_id")
  investorId       String   @map("investor_id")
  investmentAmount Decimal  @map("investment_amount") @db.Decimal(12, 2)
  sharePercentage  Decimal  @map("share_percentage") @db.Decimal(7, 4) // e.g. 50.0000%
  profitShare      Decimal  @map("profit_share") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  settlement       MonthlySettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  investor         Investor          @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([settlementId, investorId])
  @@index([investorId])
  @@map("investor_monthly_profits")
}

