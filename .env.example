# ==============================================================================
# NEED ELECTRO — Environment Variables Template (.env.example)
# DO NOT commit production secrets to Git. Copy to .env and configure values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION STRINGS (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction Pooler connection (port 6543, pgbouncer=true) for serverless queries
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct Session connection (port 5432) used for Prisma schema migrations & backups
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD API & OBJECT STORAGE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# Anon key for client-side storage queries (from Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service Role key for server-side direct bucket management (from Supabase Dashboard > Settings > API)
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket for product catalogue photos, invoices, and legal contract PDFs
STORAGE_BUCKET="needelectro-storage"

# ------------------------------------------------------------------------------
# 3. APPLICATION & CANONICAL DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Local development base URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Authoritative production storefront domain
NEXT_PUBLIC_SITE_URL="https://www.needelectro.store"

# Corporate Brand Constants
NEXT_PUBLIC_APP_NAME="NEED ELECTRO"
NEXT_PUBLIC_TAGLINE="Trusted Electrical and Technological Solutions"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
NEXT_PUBLIC_DEFAULT_CURRENCY="BDT"

# ------------------------------------------------------------------------------
# 4. SUPER ADMIN MASTER PROFILE INITIALIZATION
# ------------------------------------------------------------------------------
SUPER_ADMIN_NAME="Amdadur Rahman"
SUPER_ADMIN_EMAIL="contact.amdadur@gmail.com"
SUPER_ADMIN_PHONE="+880 1733-983752"
SUPER_ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# Master secret for session token signing and verification (32+ chars)
AUTH_SECRET=""

# Internal token for automated scheduled tasks (e.g. /api/emi/evaluate-overdue, /api/health)
CRON_SECRET=""
HEALTH_CHECK_SECRET=""

# ------------------------------------------------------------------------------
# 6. SEO & SEARCH ENGINE INDEXING PROTOCOLS
# ------------------------------------------------------------------------------
# IndexNow verification key (matches public/[key].txt)
INDEXNOW_KEY="c4a5f6e8b91240a3d76251c54b88392e"
# Webmaster verification tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# ------------------------------------------------------------------------------
# 7. NOTIFICATION GATEWAYS (SMS, WHATSAPP, EMAIL)
# ------------------------------------------------------------------------------
# SMS Gateway for Bangladesh (Options: GREENWEB, MOBIREACH, or SIMULATION)
SMS_PROVIDER="GREENWEB"
SMS_API_KEY=""
SMS_ENDPOINT="https://api.mobireach.com.bd/SendTextMessage"

# WhatsApp Cloud API credentials (optional; system falls back to direct wa.me links)
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email Provider Configuration (SMTP / Resend / SendGrid)
EMAIL_PROVIDER="SMTP"
EMAIL_API_KEY=""

# ------------------------------------------------------------------------------
# 8. EXTERNAL SEARCH ENGINES (FOR PRODUCT IMAGE ENRICHMENT - OPTIONAL)
# ------------------------------------------------------------------------------
GOOGLE_SEARCH_API_KEY=""
GOOGLE_SEARCH_CX=""
BING_SEARCH_API_KEY=""

# ------------------------------------------------------------------------------
# 9. DEPLOYMENT & CI/CD CREDENTIALS
# ------------------------------------------------------------------------------
# GitHub Personal Access Token for automated workflows and deployments
GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 10. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"
