# NEED ELECTRO ERP — Production Environment Variable Template
# DO NOT commit real secrets to source control. Configure these in Vercel & Supabase project settings.

# PostgreSQL Connection Strings (Supabase)
# DATABASE_URL: Transaction Pooler connection string (port 6543, pgbouncer=true) for serverless queries
DATABASE_URL=

# DIRECT_URL: Direct Session connection string (port 5432) used by Prisma CLI for migrations
DIRECT_URL=

# Supabase API Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production App URL (needelectroerp or Vercel production domain)
APP_URL=
NEXT_PUBLIC_APP_URL=

# Super Admin Master Profile Initialization
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

# Production Authentication Secret (32+ character high-entropy key)
AUTH_SECRET=

# Automated Keep-Alive & Cron Authorization (Optional for /api/health extended diagnostics and Vercel crons)
CRON_SECRET=
HEALTH_CHECK_SECRET=

# Supabase Storage Bucket for product images and invoices
STORAGE_BUCKET=

# Email Provider Configuration (Resend / SendGrid / SMTP)
EMAIL_PROVIDER=
EMAIL_API_KEY=

# SMS Gateway Configuration for Bangladesh (Greenweb / BulkSMS / etc.)
SMS_PROVIDER=
SMS_API_KEY=
